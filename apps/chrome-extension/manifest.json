{
  "manifest_version": 3,
  "name": "Dalai Llama",
  "version": "0.1.0",
  "description": "Add your YouTube videos to your Dalai Llama profile and publish your films to YouTube.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Dalai Llama"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.dalaillama.in/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://creator.dalaillama.in/*",
      "http://localhost:5173/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.dalaillama.in"
  }
}
