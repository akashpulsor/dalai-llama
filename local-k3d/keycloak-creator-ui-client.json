{
  "clientId": "creator-ui",
  "name": "Creator UI",
  "protocol": "openid-connect",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "implicitFlowEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": [
    "http://localhost:5181/*",
    "http://localhost:5182/*",
    "http://127.0.0.1:5181/*",
    "http://127.0.0.1:5182/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://creator.dalaillama.in/*"
  ],
  "webOrigins": [
    "http://localhost:5181",
    "http://localhost:5182",
    "http://127.0.0.1:5181",
    "http://127.0.0.1:5182",
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "https://creator.dalaillama.in"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "http://localhost:5181/*##http://localhost:5182/*##http://127.0.0.1:5181/*##http://127.0.0.1:5182/*##https://creator.dalaillama.in/*"
  },
  "fullScopeAllowed": true
}
