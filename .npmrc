# @grafana/faro-web-sdk/faro-web-tracing's dependency tree goes several
# levels deep (@grafana/faro-core, @opentelemetry/*, ua-parser-js,
# web-vitals, ...) through packages pnpm's strict node_modules isolation
# buries inside each package's own private store subtree -- Vite/Rollup's
# static import resolution can't traverse that for a production build
# (`vite build` failing repeatedly with "Rollup failed to resolve import X
# from .../faro-web-sdk/dist/esm/..." for a different X each time a scoped
# public-hoist-pattern was tried). shamefully-hoist flattens node_modules
# like npm/yarn classic, resolving the whole tree in one shot. Private,
# unpublished workspace apps -- the usual risk (masking phantom
# dependencies) doesn't really apply here.
shamefully-hoist=true
