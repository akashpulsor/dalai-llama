{
  "name": "dalaillama-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev:platform": "npm run dev --workspace=platform-ui",
    "dev:dashboard": "npm run dev --workspace=dashboard-ui",
    "dev:agent": "npm run dev --workspace=agent-ui",
    "dev:analytics": "npm run dev --workspace=analytics-ui",
    "dev:subscription": "npm run dev --workspace=subscription-ui",
    "build:platform": "npm run build --workspace=platform-ui",
    "build:dashboard": "npm run build --workspace=dashboard-ui",
    "build:agent": "npm run build --workspace=agent-ui",
    "build:analytics": "npm run build --workspace=analytics-ui",
    "build:subscription": "npm run build --workspace=subscription-ui",
    "dev:all": "npm run dev --workspaces",
    "build:all": "npm run build --workspaces"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "@reduxjs/toolkit": "^2.2.7",
    "react-router-dom": "^6.26.2",
    "react-router": "^6.26.2",
    "@remix-run/router": "^1.19.0",
    "lucide-react": "^0.452.0",
    "jwt-decode": "^4.0.0",
    "@stomp/stompjs": "^7.3.0",
    "sockjs-client": "^1.6.1",
    "use-sync-external-store": "^1.2.2",
    "redux": "^5.0.1",
    "immer": "^10.1.1",
    "reselect": "^5.1.0",
    "redux-thunk": "^3.1.0",
    "@standard-schema/utils": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
